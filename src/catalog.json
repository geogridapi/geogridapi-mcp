{
  "instructions": "GeoGridAPI measures local rankings on Google Maps. Use find_business to get a place_id, estimate_grid for the exact cost, then run_grid with a keyword, or run_grids for several listings or keywords at once (then get_batch). list_grids finds past grids, get_history shows the trend of a listing and keyword, schedule_grid repeats a grid every week or month (list_schedules, update_schedule, delete_schedule). Ranks are positions in the Google Maps results at each grid point; lower is better, null means not in the top 20.",
  "tools": [
    {
      "name": "find_business",
      "title": "Find a Google Business Profile",
      "description": "Search Google Maps listings by name and city. Returns place_id values to use with run_grid. Free.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "run_grid",
      "title": "Run a local rank grid",
      "description": "Measure where a Google Business Profile ranks on Google Maps for a keyword, on every point of a grid around it. Shapes: square (size 3, 5, 7 or 9) or circle, diamond, hexagon, cross, ellipse, rectangle (density low, medium or high, up to 49 points). Costs one credit per point (square 3×3 = 9, 7×7 = 49, 9×9 = 81; medium circle = 29; points at sea are skipped and not charged), refunded if the grid fails. Test keys (gga_test_) return free mock grids. Waits up to wait_seconds, then returns the grid id if it is still running.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "place_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "shape": {
            "type": "string",
            "enum": [
              "square",
              "circle",
              "diamond",
              "hexagon",
              "cross",
              "ellipse",
              "rectangle"
            ]
          },
          "size": {
            "anyOf": [
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 5
              },
              {
                "type": "number",
                "const": 7
              },
              {
                "type": "number",
                "const": 9
              }
            ]
          },
          "density": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "radius_km": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 30
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "country": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "wait_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          }
        },
        "required": [
          "keyword"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_grid",
      "title": "Get a grid",
      "description": "Status and result of a grid created with run_grid or the API: ranks matrix (north at the top), competitors most often in the top 3, change since the previous grid of the same listing, and the map as an image once completed.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "grid_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "grid_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_balance",
      "title": "Get the credit balance",
      "description": "Credits left on the account (1 credit = 1 grid point). Free.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_grids",
      "title": "List past grids",
      "description": "The account's grids, newest first, optionally for one listing (place_id) or one exact keyword. Returns grid_id values to use with get_grid, get_history or schedule_grid. Free.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "place_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "before": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_history",
      "title": "Get the ranking trend",
      "description": "How a listing's ranking evolves for a keyword: every completed grid of the same map (same format, radius and center), oldest first, with the change between the first and the last. Give grid_id, or place_id and keyword (the latest grid sets the format). Free.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "grid_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "place_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
