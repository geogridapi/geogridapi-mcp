    {
      "name": "run_grids",
      "title": "Run several grids at once",
      "description": "Run up to 50 grids in one call, all with the same format: one listing with several keywords, or several listings with one keyword. Each item needs place_id or query, and a keyword. Costs one credit per point of each grid (refunded if a grid fails); refused upfront when the balance cannot cover them all. Grids start as slots free up (10 at a time). Waits up to wait_seconds, then returns the batch so far: call get_batch for the rest.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "place_id": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 256
                },
                "query": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 200
                },
                "keyword": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "keyword"
              ]
            }
          },
          "shape": {
            "type": "string",
            "enum": [
              "square",
              "circle",
              "diamond",
              "hexagon",
              "cross",
              "ellipse",
              "rectangle"
            ]
          },
          "size": {
            "anyOf": [
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 5
              },
              {
                "type": "number",
                "const": 7
              },
              {
                "type": "number",
                "const": 9
              }
            ]
          },
          "density": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "radius_km": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 30
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "country": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "wait_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          }
        },
        "required": [
          "items"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
